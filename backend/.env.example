APP_NAME="SafeLink AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=safelink_db
DB_USERNAME=safelink_user
DB_PASSWORD=safelink_secret

CACHE_DRIVER=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Existing (free quotas)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=

# Free multi-source threat feeds (optional but recommended)
# PhishTank: https://www.phishtank.com/api_register.php
PHISHTANK_APP_KEY=
# abuse.ch (URLhaus): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Deep pattern analysis (server-side only — never ship in the mobile app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
